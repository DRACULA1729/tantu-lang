{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tantu",
  "scopeName": "source.tantu",
  "fileTypes": ["tn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#function-call" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.tantu"
    },
    "strings": {
      "name": "string.quoted.double.tantu",
      "begin": "\"",
      "end": "\"|(?<!\\\\)$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tantu" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.tantu" } },
      "patterns": [
        { "match": "\\\\[ntr\\\\\"]", "name": "constant.character.escape.tantu" },
        { "match": "\\\\.", "name": "invalid.illegal.unknown-escape.tantu" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b",
          "name": "constant.numeric.float.tantu"
        },
        {
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b",
          "name": "constant.numeric.float.tantu"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.integer.tantu"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|elif|else|match|while|for|in|loop|break|continue|return|spawn|select)\\b",
          "name": "keyword.control.tantu"
        },
        {
          "match": "\\b(fn|let|var|enum|struct|import)\\b",
          "name": "keyword.declaration.tantu"
        },
        {
          "match": "\\b(and|or|not)\\b",
          "name": "keyword.operator.word.tantu"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.tantu"
        },
        {
          "match": "\\b(None|Some|Ok|Err)\\b",
          "name": "support.constant.tantu"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(Int|Float|Bool|Str|Unit|List|Option|Result|Chan)\\b",
          "name": "support.type.tantu"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.tantu"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.tantu"
    }
  }
}
